{
  "name": "synapse-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "migrate": "tsx scripts/migrate.ts",
    "predev": "npm run migrate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prestart": "npm run migrate",
    "start": "node dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx src/jobs/worker.ts",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.5.1",
    "prisma": "^6.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
