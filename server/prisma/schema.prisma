generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  emailDomain String   @unique @map("email_domain") @db.VarChar(255)
  city        String?  @db.VarChar(255)
  users       User[]
  groups      Group[]

  @@map("colleges")
}

model User {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String          @unique @db.VarChar(255)
  passwordHash        String          @map("password_hash") @db.VarChar(255)
  name                String?         @db.VarChar(255)
  avatarUrl           String?         @map("avatar_url") @db.VarChar(512)
  bio                 String?         @db.Text
  collegeId           String?         @map("college_id") @db.Uuid
  yearOfStudy         Int?            @map("year_of_study")
  branch              String?         @db.VarChar(255)
  lookingFor          String?         @default("none") @map("looking_for") @db.VarChar(20)
  profileCompleteness Int             @default(0) @map("profile_completeness")
  openToInvites       Boolean         @default(true) @map("open_to_invites")
  lastActive          DateTime?       @default(now()) @map("last_active") @db.Timestamp(6)
  createdAt           DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)

  college             College?        @relation(fields: [collegeId], references: [id])
  skills              UserSkill[]
  interests           UserInterest[]
  workItems           WorkItem[]
  sentConnections     Connection[]    @relation("SentConnections")
  receivedConnections Connection[]    @relation("ReceivedConnections")
  outgoingEdges       ConnectionEdge[] @relation("OutgoingEdges")
  incomingEdges       ConnectionEdge[] @relation("IncomingEdges")
  createdGroups       Group[]         @relation("CreatedGroups")
  groupMemberships    GroupMember[]
  joinRequests        JoinRequest[]   @relation("UserJoinRequests")
  reviewedRequests    JoinRequest[]   @relation("ReviewedJoinRequests")
  refreshTokens       RefreshToken[]
  blockedUsers        UserBlock[]     @relation("BlockedUsers")
  blockedBy           UserBlock[]     @relation("BlockedByUsers")
  sentInvites         GroupInvite[]   @relation("SentGroupInvites")
  receivedInvites     GroupInvite[]   @relation("ReceivedGroupInvites")
  groupMessages       GroupMessage[]

  @@map("users")
}

model Skill {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String      @unique @db.VarChar(255)
  category String      @db.VarChar(255)
  users    UserSkill[]

  @@map("skills")
}

model Interest {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String         @unique @db.VarChar(255)
  category String         @db.VarChar(255)
  users    UserInterest[]

  @@map("interests")
}

model UserSkill {
  userId      String   @map("user_id") @db.Uuid
  skillId     String   @map("skill_id") @db.Uuid
  proficiency String   @default("beginner") @db.VarChar(20)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@map("user_skills")
}

model UserInterest {
  userId     String   @map("user_id") @db.Uuid
  interestId String   @map("interest_id") @db.Uuid

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@map("user_interests")
}

model WorkItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  techUsed    String[] @default([]) @map("tech_used")
  repoUrl     String?  @map("repo_url") @db.VarChar(512)
  liveUrl     String?  @map("live_url") @db.VarChar(512)
  mediaUrl    String?  @map("media_url") @db.VarChar(512)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_items")
}

model Connection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String   @map("requester_id") @db.Uuid
  receiverId  String   @map("receiver_id") @db.Uuid
  status      String   @default("pending") @db.VarChar(20)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  requester   User     @relation("SentConnections", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User     @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model ConnectionEdge {
  userId      String   @map("user_id") @db.Uuid
  friendId    String   @map("friend_id") @db.Uuid
  connectedAt DateTime @default(now()) @map("connected_at") @db.Timestamp(6)

  user        User     @relation("OutgoingEdges", fields: [userId], references: [id], onDelete: Cascade)
  friend      User     @relation("IncomingEdges", fields: [friendId], references: [id], onDelete: Cascade)

  @@id([userId, friendId])
  @@map("connection_edges")
}

model Group {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @db.VarChar(255)
  description String?        @db.Text
  creatorId   String         @map("creator_id") @db.Uuid
  collegeId   String?        @map("college_id") @db.Uuid
  visibility  String?        @default("global") @db.VarChar(20)
  maxMembers  Int?           @default(10) @map("max_members")
  status      String?        @default("open") @db.VarChar(20)
  isCommunity Boolean        @default(false) @map("is_community")
  expiresAt   DateTime?      @map("expires_at") @db.Timestamp(6)
  createdAt   DateTime?      @default(now()) @map("created_at") @db.Timestamp(6)

  creator     User           @relation("CreatedGroups", fields: [creatorId], references: [id])
  college     College?       @relation(fields: [collegeId], references: [id])
  members     GroupMember[]
  postings    BoardPosting[]
  joinRequests JoinRequest[]
  invites     GroupInvite[]
  messages    GroupMessage[]

  @@map("groups")
}

model GroupMember {
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  role     String   @default("member") @db.VarChar(20)
  joinedAt DateTime? @default(now()) @map("joined_at") @db.Timestamp(6)

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@map("group_members")
}

model BoardPosting {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId             String        @map("group_id") @db.Uuid
  boardType           String        @default("global") @map("board_type") @db.VarChar(20)
  title               String        @db.VarChar(255)
  description         String?       @db.Text
  rolesNeeded         String[]      @default([]) @map("roles_needed")
  requiredSkillIds    String[]      @default([]) @map("required_skill_ids") @db.Uuid
  requiredInterestIds String[]      @default([]) @map("required_interest_ids") @db.Uuid
  slotsTotal          Int           @default(1) @map("slots_total")
  slotsFilled         Int?          @default(0) @map("slots_filled")
  community           String        @default("project") @db.VarChar(50)
  expiresAt           DateTime?     @map("expires_at") @db.Timestamp(6)
  status              String?       @default("open") @db.VarChar(20)
  createdAt           DateTime?     @default(now()) @map("created_at") @db.Timestamp(6)

  group               Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinRequests        JoinRequest[]

  @@map("board_postings")
}

model JoinRequest {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postingId  String       @map("posting_id") @db.Uuid
  groupId    String       @map("group_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  message    String?      @db.Text
  status     String?      @default("pending") @db.VarChar(20)
  reviewedBy String?      @map("reviewed_by") @db.Uuid
  createdAt  DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  reviewedAt DateTime?    @map("reviewed_at") @db.Timestamp(6)

  posting    BoardPosting @relation(fields: [postingId], references: [id], onDelete: Cascade)
  group      Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user       User         @relation("UserJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewer   User?        @relation("ReviewedJoinRequests", fields: [reviewedBy], references: [id])

  @@unique([postingId, userId])
  @@map("join_requests")
}

model GroupInvite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  inviterId String   @map("inviter_id") @db.Uuid
  inviteeId String   @map("invitee_id") @db.Uuid
  note      String?  @db.Text
  status    String   @default("pending") @db.VarChar(20)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter   User     @relation("SentGroupInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee   User     @relation("ReceivedGroupInvites", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@map("group_invites")
}

model GroupMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  content   String   @db.Text
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("group_messages")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  blocker   User     @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}
